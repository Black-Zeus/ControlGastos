# ==============================================================
# .env.dev.example — Overrides para entorno dev
# Copiar a .env.dev y ajustar según sea necesario.
# ==============================================================

ENV=dev

# ── Logs (bind-mount) ────────────────────────────────────────
LOGS_ROOT=./APP/logs/dev

# ── Puertos expuestos (solo en dev) ────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── URL base de la API ───────────────────────────────────────
# Mismo origen que el frontend (vía proxy nginx en :80), igual que en
# qa/prd. Necesario para que la cookie httpOnly de sesión funcione
# (las cookies cross-origin sobre http no son fiables entre navegadores).
# Accede a la app en http://localhost, no directo a :5173/:8000.
VITE_API_BASE_URL=/api

# ── Debug ───────────────────────────────────────────────────
DEBUG=true
LOG_LEVEL=DEBUG
