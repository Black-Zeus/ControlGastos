# ==============================================================
# .env.dev.example — Overrides para entorno dev
# Copiar a .env.dev y ajustar según sea necesario.
# ==============================================================

ENV=dev

# ── Rutas de persistencia ───────────────────────────────────
DATA_ROOT=./APP/data/dev
LOGS_ROOT=./APP/logs/dev
VOLUMES_ROOT=./APP/volumes

# ── Puertos expuestos (solo en dev) ────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── URL base de la API (para Vite dev server) ───────────────
# El browser en dev accede al backend directamente
VITE_API_BASE_URL=http://localhost:8000

# ── Debug ───────────────────────────────────────────────────
DEBUG=true
LOG_LEVEL=DEBUG
