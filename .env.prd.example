# ==============================================================
# .env.prd.example — Overrides para entorno PRD
# Copiar a .env.prd y ajustar según sea necesario.
# ==============================================================

ENV=prd

# ── Logs de nginx (bind-mount) ───────────────────────────────
LOGS_ROOT=./APP/logs/prd

# ── Puertos expuestos ───────────────────────────────────────
PROXY_PORT=80

# ── URL base de la API — nginx enruta /api/ al backend
VITE_API_BASE_URL=/api

# ── CORS — dominio real de la app ───────────────────────────
# Sin barra final. Si usas www y sin www, separa con coma:
# ALLOWED_ORIGINS=https://app.midominio.com,https://www.midominio.com
ALLOWED_ORIGINS=https://app.midominio.com

# ── Debug ───────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=WARNING
