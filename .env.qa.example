# ==============================================================
# .env.qa.example — Overrides para entorno QA
# Copiar a .env.qa y ajustar según sea necesario.
# ==============================================================

ENV=qa

# ── Rutas de persistencia ───────────────────────────────────
DATA_ROOT=./APP/data/qa
LOGS_ROOT=./APP/logs/qa
VOLUMES_ROOT=./APP/volumes

# ── Puertos expuestos ───────────────────────────────────────
PROXY_PORT=8080
# En QA, backend se expone para pruebas directas
BACKEND_PORT=8001
MINIO_CONSOLE_PORT=9001

# ── URL base de la API (relativa, pasa por proxy nginx) ─────
VITE_API_BASE_URL=/api

# ── Debug ───────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
