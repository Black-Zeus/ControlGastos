# ==============================================================
# .env.example — Variables base del proyecto
# Copiar a .env y completar los valores reales.
# Las variables aquí son comunes a todos los entornos.
# Las variables específicas de entorno van en .env.dev / .env.qa / .env.prd
# ==============================================================

# ── Identificación del proyecto ────────────────────────────
PROJECT_NAME=controlgastos

# ── Base de datos ───────────────────────────────────────────
POSTGRES_USER=controlgastos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=controlgastos_db

# ── Almacenamiento (MinIO) ──────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_MIN8CHARS
MINIO_BUCKET=receipts

# ── Seguridad (JWT) ─────────────────────────────────────────
# Generar con: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ────────────────────────────────────────────────────
# En PRD: el dominio real de la app, ej: https://app.midominio.com
# En dev: http://localhost:5173
ALLOWED_ORIGINS=http://localhost
