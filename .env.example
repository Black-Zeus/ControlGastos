# ==============================================================
# .env.example — Plantilla única de variables de entorno
#
# docker_tools_v3.sh carga SIEMPRE dos archivos juntos:
#     --env-file .env --env-file .env.<ENV>
#
# Este archivo documenta ambos en un solo lugar. NO se copia entero:
# cada sección de abajo se copia al archivo real que indica su título.
#
#   1) Sección COMÚN            → copiar a .env       (una sola vez)
#   2) Sección DEV / QA / PRD   → copiar SOLO la que corresponda
#                                  al archivo .env.<ENV> de ese entorno
#                                  (.env.dev, .env.qa o .env.prd)
#
# .env y .env.<ENV> nunca se commitean (ver .gitignore) — solo esta
# plantilla queda versionada.
# ==============================================================


# ══════════════════════════════════════════════════════════════
# 1) SECCIÓN COMÚN — copiar a .env
#    Compartida por los 3 entornos (dev/qa/prd usan las mismas
#    credenciales de base de datos, MinIO y JWT).
# ══════════════════════════════════════════════════════════════

# ── Identificación del proyecto ────────────────────────────
PROJECT_NAME=controlgastos

# ── Base de datos ───────────────────────────────────────────
POSTGRES_USER=controlgastos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=controlgastos_db

# ── Almacenamiento (MinIO) ──────────────────────────────────
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MIN8CHARS
MINIO_BUCKET=receipts

# ── Seguridad (JWT) ─────────────────────────────────────────
# Generar con: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30


# ══════════════════════════════════════════════════════════════
# 2a) SECCIÓN DEV — copiar a .env.dev
#     Acceder siempre vía http://localhost (proxy nginx en :80),
#     nunca directo a :5173/:8000 — las cookies httpOnly de sesión
#     requieren mismo origen entre frontend y backend.
# ══════════════════════════════════════════════════════════════

ENV=dev

# ── Puertos expuestos al host (solo para debug/acceso directo) ─
BACKEND_PORT=8000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_PORT=8025

# ── Debug ───────────────────────────────────────────────────
DEBUG=true
LOG_LEVEL=DEBUG


# ══════════════════════════════════════════════════════════════
# 2b) SECCIÓN QA — copiar a .env.qa
# ══════════════════════════════════════════════════════════════

ENV=qa

# ── Logs de nginx (bind-mount) ───────────────────────────────
LOGS_ROOT=./APP/logs/qa

# ── Puertos expuestos ───────────────────────────────────────
PROXY_PORT=8080
# En QA el backend se expone también directo, para pruebas de API
BACKEND_PORT=8001
MINIO_CONSOLE_PORT=9001

# ── URL base de la API (relativa, pasa por el proxy nginx) ──
VITE_API_BASE_URL=/api

# ── Debug ───────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO


# ══════════════════════════════════════════════════════════════
# 2c) SECCIÓN PRD — copiar a .env.prd
# ══════════════════════════════════════════════════════════════

ENV=prd

# ── Logs de nginx (bind-mount) ───────────────────────────────
LOGS_ROOT=./APP/logs/prd

# ── Puertos expuestos (solo nginx sale a internet) ──────────
PROXY_PORT=80

# ── URL base de la API (relativa, pasa por el proxy nginx) ──
VITE_API_BASE_URL=/api

# ── CORS — dominio real de la app, sin barra final ──────────
# Si usas www y sin www, separa con coma:
# ALLOWED_ORIGINS=https://app.tudominio.com,https://www.tudominio.com
ALLOWED_ORIGINS=https://app.tudominio.com

# ── Debug ───────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=WARNING
